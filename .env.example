# =====================================================================
# VALHEIM SENTINEL & SKALD — ENVIRONMENT CONFIGURATION
# Copy this file to .env and customize with your own settings.
# =====================================================================

# --- Server Lifecycle & Game Settings ---
VALHEIM_SERVER_DIR=/home/steam/valheim_server
VALHEIM_WORLDS_DIR=/home/steam/.config/unity3d/IronGate/Valheim/worlds_local
VALHEIM_BACKUP_DIR=/home/steam/valheim_backups
VALHEIM_LOG_FILE=/home/steam/valheim_server/current_run.log
VALHEIM_SERVER_NAME="My Viking Realm"
VALHEIM_WORLD_NAME="Dedicated"
VALHEIM_SERVER_PASSWORD="SecretPassword123"
VALHEIM_SERVER_PORT=2458
VALHEIM_PUBLIC=1
VALHEIM_CROSSPLAY=1

# --- Timezone & Localization ---
TIMEZONE_OFFSET_HOURS=0.0
TIMEZONE_NAME="UTC"

# --- Notification Channels (Enable any or all) ---
# Discord Webhook (Recommended for gaming servers)
DISCORD_WEBHOOK_URL=

# Telegram Alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# WhatsApp HTTP Bridge (e.g., Baileys / Hermes)
WHATSAPP_BRIDGE_URL=
WHATSAPP_GROUP_ID=

# --- AI Skald Saga Engine (Generative Norse Lore) ---
# Free Google AI Studio API key: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
